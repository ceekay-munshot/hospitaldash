{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hospitaldash",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dashboard/dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "cd dashboard && npm install --no-audit --no-fund && npm run build"
  }
}
