# Local Worker secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored) and fill in.
# In production set these as Cloudflare secrets, NOT here.

# Bearer token for the shared Munshot email API. If unset, sending is skipped
# (no crash) — subscribe/run-digests still work, they just don't deliver mail.
MUNS_TOKEN=

# Shared secret the hourly GitHub Action sends as the `x-digest-key` header to
# unlock POST /api/run-digests. Pick any long random string; use the SAME value
# for the GitHub Actions `DIGEST_KEY` secret.
DIGEST_KEY=dev-only-change-me

# Optional overrides
# MUNS_EMAIL_ENDPOINT=https://devde.muns.io/email/send/raw
# SITE_URL=http://localhost:8787
# BRAND_LOGO_URL=
# SEND_EMPTY=false
